# ============================================================================
# HDFS Configuration for Docker Cluster (IT4931 - Group 3)
# Block Size = 128MB (134217728 bytes), Replication Factor = 1 (Local Cluster)
# Reference: Proposal Section III.1 & IT4931 Note 3 (HDFS Architecture)
# ============================================================================

CORE-SITE.XML_fs.defaultFS=hdfs://hdfs-namenode-service:9000
CORE-SITE.XML_fs.trash.interval=1440
CORE-SITE.XML_io.file.buffer.size=131072

HDFS-SITE.XML_dfs.replication=1
HDFS-SITE.XML_dfs.blocksize=134217728
HDFS-SITE.XML_dfs.namenode.name.dir=file:///hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=file:///hadoop/dfs/data
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.webhdfs.enabled=true
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true

