FROM bitnami/spark:3.5.1

USER root
WORKDIR /app

RUN pip install --no-cache-dir \
    kafka-python-ng==2.2.2 \
    psycopg2-binary==2.9.9 \
    sqlalchemy==2.0.30 \
    pandas==2.2.2 \
    pyarrow==16.1.0 \
    numpy==1.26.4 \
    psutil==5.9.8

# Download Kafka & PostgreSQL JDBC jars for Spark Structured Streaming & Batch Serving
RUN curl -sL https://repo1.maven.org/maven2/org/postgresql/postgresql/42.7.3/postgresql-42.7.3.jar \
    -o /opt/bitnami/spark/jars/postgresql-42.7.3.jar

COPY src /app/src
COPY scripts /app/scripts

ENV PYTHONPATH=/app
USER 1001

